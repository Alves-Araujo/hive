rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Depois que o cadastro e finalizado (perfilCompleto), CPF e CNPJ ficam
    // imutaveis: sao o que identifica a pessoa em anuncio, chat e avaliacao,
    // entao trocar o numero valeria por trocar de pessoa numa conta que ja
    // tem historico. Antes a regra so olhava o dono, e o app inteiro
    // confiava na tela -- quem chamasse o Firestore direto reescrevia
    function documentoImutavel(campo) {
      return resource.data.get(campo, '') == ''
      || request.resource.data.get(campo, '') == resource.data.get(campo, '');
    }

    // documento da empresa/do responsavel e vinculo, nao identidade: pode ser
    // apagado (deixou de ser corretor de empresa, fez 18 anos), so nao pode
    // ser trocado por outro numero de uma vez
    function vinculoImutavel(campo) {
      return request.resource.data.get(campo, '') == ''
      || documentoImutavel(campo);
    }

    // Tipo de conta segue a mesma regra do documento, e pelo mesmo motivo: ele
    // decide o que a conta PODE FAZER (anunciar, vincular imobiliaria) e ja
    // circulou em anuncio, chat e avaliacao com esse papel. O subtipo do
    // corretor anda junto -- trocar "empresa" por "autonomo" seria fugir da
    // aprovacao da imobiliaria e sair anunciando. A tela ja bloqueia os dois
    // campos; aqui e o que vale pra quem chama o Firestore direto
    function cadastroPreservado() {
      return resource.data.get('perfilCompleto', false) != true
      || (documentoImutavel('cpf')
      && documentoImutavel('cnpj')
      && documentoImutavel('tipoUsuario')
      && documentoImutavel('subtipoCorretor')
      && vinculoImutavel('cnpjEmpresa')
      && vinculoImutavel('responsavelCpf'));
    }

    // perfil do usuario (dados sensiveis: cpf, endereco, telefone...) -- so
    // o dono le e escreve o proprio
    match /usuarios/{uid} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
      && cadastroPreservado();

      // avaliacoes recebidas -- qualquer logado le e cria a sua, ninguem edita
      // a de outra pessoa depois de publicada
      match /avaliacoes/{avaliacaoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.avaliadorUid == request.auth.uid;
      }

      // avisos pessoais (mensagem, avaliacao) -- so o dono le e apaga; quem
      // gera o aviso so cria, assinando com o proprio uid, e nunca pra si
      match /notificacoes/{notificacaoId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.autorUid == request.auth.uid;
      }
    }

    // avisos pra todo mundo (moradia, evento, imobiliaria nova). Leitura
    // aberta pra quem esta logado; criacao assinada com o proprio uid e
    // restrita a esses tipos. Ninguem edita ou apaga aviso depois de criado
    match /notificacoes/{notificacaoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
      && request.resource.data.autorUid == request.auth.uid
      && request.resource.data.tipo in ['novaMoradia', 'novoEvento', 'novaImobiliaria'];
    }

    // versao publica do perfil (nome, foto, tipo de conta...) -- sem dado
    // sensivel, entao qualquer logado pode ler (busca, chat, vitrine...)
    match /perfisPublicos/{uid} {
      allow read: if request.auth != null;

      // A resposta ao vinculo nao e escrita por quem pediu. O dono grava o
      // proprio perfil (sincronizar dados, ultimo acesso), mas nao LIGA esses
      // dois campos: bastava o corretor escrever vinculoConfirmado:true aqui
      // pra se aprovar sozinho e sair anunciando pela imobiliaria. Desligar
      // continua liberado -- e o que acontece quando ele troca de imobiliaria
      function naoSeAutoAprova(campo) {
        return request.resource.data.get(campo, false) == false
        || request.resource.data.get(campo, false) == resource.data.get(campo, false);
      }

      allow create: if request.auth != null && request.auth.uid == uid
      && request.resource.data.get('vinculoConfirmado', false) == false
      && request.resource.data.get('vinculoRecusado', false) == false;

      allow update: if request.auth != null && request.auth.uid == uid
      && naoSeAutoAprova('vinculoConfirmado')
      && naoSeAutoAprova('vinculoRecusado');

      // A resposta ao pedido de vinculo e dada por OUTRA pessoa: quem entra
      // com o e-mail da imobiliaria aprova (ou recusa) os corretores dela.
      // Antes a escrita era liberada pra qualquer logado em qualquer perfil --
      // dava pra trocar nome e foto de quem quisesse. Agora o terceiro liga UM
      // dos dois campos de resposta, e so se o e-mail CONFIRMADO do login for
      // o da imobiliaria a que esse corretor diz pertencer
      allow update: if request.auth != null
      && request.auth.token.email_verified == true
      && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vinculoConfirmado'])
        && request.resource.data.vinculoConfirmado == true)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vinculoRecusado'])
        && request.resource.data.vinculoRecusado == true)
      )
      && resource.data.imobiliariaId is string
      && resource.data.imobiliariaId != ''
      && get(/databases/$(database)/documents/imobiliarias/$(resource.data.imobiliariaId)).data.emailBusca
      == request.auth.token.email.lower();
    }

    // imobiliarias -- publicas pra leitura/busca e pro pin no mapa
    match /imobiliarias/{imobiliariaId} {
      allow read: if request.auth != null;

      // qualquer corretor logado cadastra a imobiliaria dele, mas ela nasce
      // SEMPRE nao confirmada -- confirmar e trabalho do dono do e-mail
      allow create: if request.auth != null
      && request.resource.data.emailVerificado == false;

      // A imobiliaria nao e um tipo de conta: quem responde por ela e quem
      // entra com o e-mail dela, confirmado (o mesmo criterio ja usado pra
      // aprovar corretor la em cima, em perfisPublicos)
      //
      // Tudo por get() com padrao: login por telefone (ou anonimo) nao tem
      // "email" nenhum no token, e ler o campo direto derruba a avaliacao da
      // regra inteira. E a comparacao exige os dois lados preenchidos --
      // senao um cadastro antigo, gravado sem emailBusca, casaria com o
      // e-mail vazio de QUALQUER conta dessas
      function souAImobiliaria() {
        return request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') != ''
        && resource.data.get('emailBusca', '') != ''
        && request.auth.token.get('email', '').lower() == resource.data.get('emailBusca', '');
      }

      allow update: if request.auth != null && (
        // so quem entra com o e-mail (confirmado) da imobiliaria a confirma.
        // Antes qualquer logado podia marcar emailVerificado em qualquer uma
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerificado'])
        && souAImobiliaria())
        ||
        // completar endereco e coordenada de cadastro antigo (pin no mapa)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endereco', 'latitude', 'longitude'])
        ||
        // A imobiliaria edita o PROPRIO cadastro (nome, descricao, telefone,
        // logotipo, fotos do escritorio, endereco). "fotoUrl" e o logotipo
        // (o avatar redondo) e "fotos" e a galeria que o painel do pin mostra
        // -- sao dois campos porque servem a coisas diferentes.
        //
        // Antes nao havia caminho nenhum pra isso: trocar o
        // nome da empresa exigia abrir outra conta, e os corretores ja
        // vinculados ficavam apontando pro cadastro velho.
        //
        // Fica de fora o que identifica a empresa e o que decide quem manda
        // nela: cnpj/cnpjBusca (chave de "encontrarOuCriar" -- dois cadastros
        // podiam colidir no mesmo numero), email/emailBusca (trocar entregaria
        // a imobiliaria, e os corretores dela, pra outra conta) e
        // emailVerificado (que so a confirmacao acima liga)
        (request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['nome', 'nomeBusca', 'descricao', 'telefone', 'fotoUrl', 'fotos', 'endereco', 'latitude', 'longitude'])
        && souAImobiliaria()
        && request.resource.data.nome is string
        && request.resource.data.nome.trim() != '')
      );

      match /avaliacoes/{avaliacaoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.avaliadorUid == request.auth.uid;
      }
    }

    function perfilCompleto() {
      return request.auth != null &&
      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfilCompleto == true;
    }

    // anuncios (moradias/eventos) -- qualquer logado le, mas so quem completou
    // o perfil pode criar, e so o dono edita/apaga o seu.
    //
    // A categoria (moradia/evento) e escolhida na publicacao e nao muda mais:
    // um anuncio que troca de tipo deixa pra tras os campos que so o tipo
    // antigo usa (IPTU, comprovante) e some da aba onde as pessoas ja o
    // encontravam. A tela de edicao ja desliga o seletor; esta regra e o que
    // vale pra quem chama o Firestore direto
    match /imoveis/{imovelId} {
      // O relogio que tira do mapa anuncio abandonado (cinco meses com
      // mensagem sem resposta -- ver lib/utils/inatividade.dart) e ligado por
      // QUEM MANDA a mensagem, que nao e o dono do anuncio. Dai a segunda
      // regra de update abaixo, a unica coisa que alguem de fora escreve num
      // anuncio alheio.
      //
      // O que ela amarra, pra isso nao virar uma porta de entrada:
      // - so esse campo muda, e com o horario do SERVIDOR (request.time) --
      //   ninguem antecipa a data pra derrubar anuncio dos outros
      // - so liga o que esta desligado: o prazo conta da PRIMEIRA mensagem
      //   sem resposta, e reescrever o campo so serviria pra adiar
      // - so quem realmente abriu conversa com o dono NESTE anuncio, provado
      //   pela existencia do chat (o id dele e derivado dos dois uids e do
      //   imovelId -- o mesmo idDerivado() usado em /chats la embaixo)
      // Desligar e coisa do dono, e cai na regra de update dele
      function chatComODono() {
        let dono = resource.data.get('donoUid', '');
        let eu = request.auth.uid;
        let p = eu < dono ? [eu, dono] : [dono, eu];
        return imovelId + '_' + p[0] + '_' + p[1];
      }
      function relogioDesligado() {
        return !('aguardandoRespostaDesde' in resource.data)
        || resource.data.aguardandoRespostaDesde == null;
      }

      allow read: if request.auth != null;
      allow create: if perfilCompleto()
      && request.resource.data.donoUid == request.auth.uid;
      allow update: if request.auth != null
      && resource.data.donoUid == request.auth.uid
      && request.resource.data.get('tipo', '') == resource.data.get('tipo', '');
      allow update: if request.auth != null
      && request.auth.uid != resource.data.get('donoUid', '')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aguardandoRespostaDesde'])
      // get() com padrao, nao leitura direta: quando a escrita APAGA o campo
      // (o desligar, que so o dono faz) ele nao existe no request.resource, e
      // ler direto ali seria erro de avaliacao no meio da regra
      && request.resource.data.get('aguardandoRespostaDesde', null) == request.time
      && relogioDesligado()
      && exists(/databases/$(database)/documents/chats/$(chatComODono()));
      allow delete: if request.auth != null
      && resource.data.donoUid == request.auth.uid;
    }

    // Chat. Conversa e sempre entre DUAS pessoas, e quem manda nisso e o
    // documento pai chats/{chatId}, com o campo participantes. Antes a regra
    // era "qualquer logado le", e o id do chat de anuncio era o proprio
    // imovelId -- entao todo mundo lia a conversa de todo mundo, e os
    // interessados num mesmo anuncio caiam todos na mesma sala
    match /chats/{chatId} {
      function participantes() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
      function souParticipante() {
        return request.auth != null && request.auth.uid in participantes();
      }

      // O id do chat TEM que ser o id derivado dos participantes:
      // "direto_<uid>_<uid>" no chat de perfil, "<imovelId>_<uid>_<uid>" no de
      // anuncio. Sem isso, bastava criar o pai de um chat antigo (id =
      // imovelId), se pondo como participante, pra destrancar justamente o
      // historico que essa mudanca fecha
      function idDerivado() {
        let p = request.resource.data.participantes;
        // o chat direto nao grava imovelId -- dai o get() com padrao vazio
        let imovel = request.resource.data.get('imovelId', '');
        let prefixo = imovel == '' ? 'direto' : imovel;
        return prefixo + '_' + p[0] + '_' + p[1];
      }
      function paiValido() {
        let p = request.resource.data.participantes;
        // p[0] < p[1] cobre as duas coisas: ordenados (pros dois lados
        // chegarem ao mesmo id) e sem conversa de alguem consigo mesmo
        return p is list && p.size() == 2 && p[0] < p[1]
        && request.auth.uid in p
        && chatId == idDerivado();
      }

      allow get: if souParticipante();

      // a caixa de entrada consulta where('participantes', arrayContains: meu
      // uid), e o firestore so aceita a consulta que garante esse filtro --
      // por isso list fica separado de get, olhando resource.data
      allow list: if request.auth != null && request.auth.uid in resource.data.participantes;

      allow create: if perfilCompleto() && paiValido();

      // so a previa/horario mudam depois; trocar os participantes seria
      // entrar numa conversa alheia
      allow update: if souParticipante() && perfilCompleto()
      && request.resource.data.participantes == resource.data.participantes;

      // quem le e escreve e so quem esta no pai. A regra olha o PAI, nao a
      // mensagem: regra sobre resource.data da mensagem reprovaria a consulta
      // orderBy('timestamp') inteira. Sem update e sem delete -- ninguem
      // reescreve nem apaga o que ja foi dito
      match /mensagens/{mensagemId} {
        allow read: if souParticipante();
        allow create: if souParticipante() && perfilCompleto()
        && request.resource.data.remetenteUid == request.auth.uid;
      }
    }

    // estrutura pronta pras monitorias futuras
    match /monitorias/{monitoriaId} {
      allow read, write: if request.auth != null;
    }
  }
}