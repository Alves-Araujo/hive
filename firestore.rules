rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Depois que o cadastro e finalizado (perfilCompleto), CPF e CNPJ ficam
    // imutaveis: sao o que identifica a pessoa em anuncio, chat e avaliacao,
    // entao trocar o numero valeria por trocar de pessoa numa conta que ja
    // tem historico. Antes a regra so olhava o dono, e o app inteiro
    // confiava na tela -- quem chamasse o Firestore direto reescrevia
    function documentoImutavel(campo) {
      return resource.data.get(campo, '') == ''
      || request.resource.data.get(campo, '') == resource.data.get(campo, '');
    }

    // documento da empresa/do responsavel e vinculo, nao identidade: pode ser
    // apagado (deixou de ser corretor de empresa, fez 18 anos), so nao pode
    // ser trocado por outro numero de uma vez
    function vinculoImutavel(campo) {
      return request.resource.data.get(campo, '') == ''
      || documentoImutavel(campo);
    }

    function documentosPreservados() {
      return resource.data.get('perfilCompleto', false) != true
      || (documentoImutavel('cpf')
      && documentoImutavel('cnpj')
      && vinculoImutavel('cnpjEmpresa')
      && vinculoImutavel('responsavelCpf'));
    }

    // perfil do usuario (dados sensiveis: cpf, endereco, telefone...) -- so
    // o dono le e escreve o proprio
    match /usuarios/{uid} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
      && documentosPreservados();

      // avaliacoes recebidas -- qualquer logado le e cria a sua, ninguem edita
      // a de outra pessoa depois de publicada
      match /avaliacoes/{avaliacaoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.avaliadorUid == request.auth.uid;
      }

      // avisos pessoais (mensagem, avaliacao) -- so o dono le e apaga; quem
      // gera o aviso so cria, assinando com o proprio uid, e nunca pra si
      match /notificacoes/{notificacaoId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.autorUid == request.auth.uid;
      }
    }

    // avisos pra todo mundo (moradia, evento, imobiliaria nova). Leitura
    // aberta pra quem esta logado; criacao assinada com o proprio uid e
    // restrita a esses tipos. Ninguem edita ou apaga aviso depois de criado
    match /notificacoes/{notificacaoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
      && request.resource.data.autorUid == request.auth.uid
      && request.resource.data.tipo in ['novaMoradia', 'novoEvento', 'novaImobiliaria'];
    }

    // versao publica do perfil (nome, foto, tipo de conta...) -- sem dado
    // sensivel, entao qualquer logado pode ler (busca, chat, vitrine...)
    match /perfisPublicos/{uid} {
      allow read: if request.auth != null;

      // o dono grava o proprio (sincronizar o perfil, ultimo acesso)
      allow create, update: if request.auth != null && request.auth.uid == uid;

      // A confirmacao de vinculo e feita por OUTRA pessoa: quem entra com o
      // e-mail da imobiliaria confirma os corretores dela. Antes a escrita
      // era liberada pra qualquer logado em qualquer perfil -- dava pra
      // trocar nome e foto de quem quisesse. Agora o terceiro so liga o
      // campo vinculoConfirmado, e so se o e-mail CONFIRMADO do login for o
      // da imobiliaria a que esse corretor diz pertencer
      allow update: if request.auth != null
      && request.auth.token.email_verified == true
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vinculoConfirmado'])
      && request.resource.data.vinculoConfirmado == true
      && resource.data.imobiliariaId is string
      && resource.data.imobiliariaId != ''
      && get(/databases/$(database)/documents/imobiliarias/$(resource.data.imobiliariaId)).data.emailBusca
      == request.auth.token.email.lower();
    }

    // imobiliarias -- publicas pra leitura/busca e pro pin no mapa
    match /imobiliarias/{imobiliariaId} {
      allow read: if request.auth != null;

      // qualquer corretor logado cadastra a imobiliaria dele, mas ela nasce
      // SEMPRE nao confirmada -- confirmar e trabalho do dono do e-mail
      allow create: if request.auth != null
      && request.resource.data.emailVerificado == false;

      allow update: if request.auth != null && (
        // so quem entra com o e-mail (confirmado) da imobiliaria a confirma.
        // Antes qualquer logado podia marcar emailVerificado em qualquer uma
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerificado'])
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == resource.data.emailBusca)
        ||
        // completar endereco e coordenada de cadastro antigo (pin no mapa)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endereco', 'latitude', 'longitude'])
      );

      match /avaliacoes/{avaliacaoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.avaliadorUid == request.auth.uid;
      }
    }

    function perfilCompleto() {
      return request.auth != null &&
      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfilCompleto == true;
    }

    // anuncios (moradias/eventos) -- qualquer logado le, mas so quem completou
    // o perfil pode criar, e so o dono edita/apaga o seu
    match /imoveis/{imovelId} {
      allow read: if request.auth != null;
      allow create: if perfilCompleto()
      && request.resource.data.donoUid == request.auth.uid;
      allow update, delete: if request.auth != null
      && resource.data.donoUid == request.auth.uid;
    }

    // Chat. Conversa e sempre entre DUAS pessoas, e quem manda nisso e o
    // documento pai chats/{chatId}, com o campo participantes. Antes a regra
    // era "qualquer logado le", e o id do chat de anuncio era o proprio
    // imovelId -- entao todo mundo lia a conversa de todo mundo, e os
    // interessados num mesmo anuncio caiam todos na mesma sala
    match /chats/{chatId} {
      function participantes() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
      function souParticipante() {
        return request.auth != null && request.auth.uid in participantes();
      }

      // O id do chat TEM que ser o id derivado dos participantes:
      // "direto_<uid>_<uid>" no chat de perfil, "<imovelId>_<uid>_<uid>" no de
      // anuncio. Sem isso, bastava criar o pai de um chat antigo (id =
      // imovelId), se pondo como participante, pra destrancar justamente o
      // historico que essa mudanca fecha
      function idDerivado() {
        let p = request.resource.data.participantes;
        // o chat direto nao grava imovelId -- dai o get() com padrao vazio
        let imovel = request.resource.data.get('imovelId', '');
        let prefixo = imovel == '' ? 'direto' : imovel;
        return prefixo + '_' + p[0] + '_' + p[1];
      }
      function paiValido() {
        let p = request.resource.data.participantes;
        // p[0] < p[1] cobre as duas coisas: ordenados (pros dois lados
        // chegarem ao mesmo id) e sem conversa de alguem consigo mesmo
        return p is list && p.size() == 2 && p[0] < p[1]
        && request.auth.uid in p
        && chatId == idDerivado();
      }

      allow get: if souParticipante();

      // a caixa de entrada consulta where('participantes', arrayContains: meu
      // uid), e o firestore so aceita a consulta que garante esse filtro --
      // por isso list fica separado de get, olhando resource.data
      allow list: if request.auth != null && request.auth.uid in resource.data.participantes;

      allow create: if perfilCompleto() && paiValido();

      // so a previa/horario mudam depois; trocar os participantes seria
      // entrar numa conversa alheia
      allow update: if souParticipante() && perfilCompleto()
      && request.resource.data.participantes == resource.data.participantes;

      // quem le e escreve e so quem esta no pai. A regra olha o PAI, nao a
      // mensagem: regra sobre resource.data da mensagem reprovaria a consulta
      // orderBy('timestamp') inteira. Sem update e sem delete -- ninguem
      // reescreve nem apaga o que ja foi dito
      match /mensagens/{mensagemId} {
        allow read: if souParticipante();
        allow create: if souParticipante() && perfilCompleto()
        && request.resource.data.remetenteUid == request.auth.uid;
      }
    }

    // estrutura pronta pras monitorias futuras
    match /monitorias/{monitoriaId} {
      allow read, write: if request.auth != null;
    }
  }
}